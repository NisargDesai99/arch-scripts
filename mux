#!/usr/bin/env bash

if [[ $# -eq 1 ]]; then
    selected=$1
else
  selected=$({ printf '%s\n' $MUX_PATHS; find $MUX_PATHS -mindepth 1 -maxdepth 1 -type d; } | fzf)
fi

if [[ -z $selected ]]; then
    exit 0
fi

selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep tmux)

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    tmux start-server
fi

CLAUDE="claude"
CODEX="codex"
NO_AGENT="none"

new_session=false
if ! tmux has-session -t=$selected_name 2> /dev/null; then
    agent=$(printf "$CODEX\n$CLAUDE\n$NO_AGENT" | fzf --prompt="Pick agent")

    if [[ -z $agent ]]; then
        exit 0
    fi
    if [[ -n "$TMUX" ]]; then
        win_width=$(tmux display-message -p '#{client_width}')
        win_height=$(tmux display-message -p '#{client_height}')
    else
        win_width=$(tput cols)
        win_height=$(tput lines)
    fi
    tmux new-session -ds $selected_name -c $selected -x $win_width -y $win_height
    nvim_pane=$(tmux display-message -t $selected_name -p '#{pane_id}')
    term_pane=$(tmux split-window -v -t $nvim_pane -c $selected -P -F '#{pane_id}')
    if [[ "$agent" != "$NO_AGENT" ]]; then
        case "$agent" in
            "$CLAUDE") agent_cmd="claude --resume" ;;
            "$CODEX")  agent_cmd="codex resume" ;;
        esac
        agent_pane=$(tmux split-window -h -t $nvim_pane -c $selected -P -F '#{pane_id}')
        tmux send-keys -t "$agent_pane" "$agent_cmd" C-m
    fi
    tmux send-keys -t $nvim_pane 'nvim ./' C-m
    tmux select-pane -t $term_pane
    new_session=true
fi

if [[ "$new_session" == true ]]; then
    tmux resize-pane -t $term_pane -y 21
    if [[ -n "$agent_pane" ]]; then
        tmux resize-pane -t $agent_pane -x 86
    fi
fi

if [[ -n "$TMUX" ]]; then
    tmux switch-client -t $selected_name
else
    tmux attach -t $selected_name
fi


