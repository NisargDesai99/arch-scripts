#!/usr/bin/env bash
#
# install-tools.sh
# Cross-platform dev tooling installer — data-driven, idempotent, package-managers only.
#
# Platforms (auto-detected):
#   arch | wsl-ubuntu | asahi (Fedora Asahi Remix) | macos (Homebrew)
#
# ARCHITECTURE
#   - Ordinary packages live in the SIMPLE_PKGS table. To add one, add a row:
#       "checkcmd  arch_name  ubuntu_name  fedora_name  macos_name"
#     Names are usually identical; override per-column when not.
#     Use "-" in a column to skip that package on that platform.
#   - A generic engine resolves the row for the current platform, skips what's
#     already installed, and installs the rest in ONE batched call.
#   - Tools needing bespoke logic (bazelisk, CUDA) get a function in SPECIAL_INSTALLERS.
#
# CUDA is installed on arch and wsl-ubuntu only — never on asahi or macos.
# Idempotent: already-present tools are skipped. FORCE=1 reinstalls/upgrades.
#
set -euo pipefail
FORCE="${FORCE:-0}"

# --------------------------------------------------------------------------
# Logging
# --------------------------------------------------------------------------
log()  { printf '\033[1;32m==>\033[0m %s\n' "$*"; }
skip() { printf '\033[1;34m-- \033[0m%s\n' "$*"; }
warn() { printf '\033[1;33m!! \033[0m%s\n' "$*" >&2; }
die()  { printf '\033[1;31mxx \033[0m%s\n' "$*" >&2; exit 1; }

# --------------------------------------------------------------------------
# Package data  (checkcmd | arch | wsl-ubuntu | asahi | macos)
# --------------------------------------------------------------------------
SIMPLE_PKGS=(
  "nvim   neovim   neovim   neovim   neovim"
  "tmux   tmux     tmux     tmux     tmux"
  "fzf    fzf      fzf      fzf      fzf"
  "rg     ripgrep  ripgrep  ripgrep  ripgrep"
  # Per-platform name differences when you grow the list:
  #   "fd   fd   fd-find   fd-find   fd"
)

# Tools that need custom, platform-specific install logic:
SPECIAL_INSTALLERS=(install_bazelisk install_cuda)

# --------------------------------------------------------------------------
# Platform detection
# --------------------------------------------------------------------------
PLATFORM=""
detect_platform() {
  # macOS first — it has no /etc/os-release.
  if [[ "$(uname -s)" == "Darwin" ]]; then
    PLATFORM="macos"
    if ! command -v brew >/dev/null 2>&1; then
      local b
      for b in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        [[ -x "$b" ]] && { eval "$("$b" shellenv)"; break; }
      done
    fi
    command -v brew >/dev/null 2>&1 \
      || die "Homebrew not found. Install it from https://brew.sh then re-run."
    log "Platform: macos ($(uname -m))   FORCE=${FORCE}"
    return 0
  fi

  local id="" id_like=""
  if [[ -r /etc/os-release ]]; then
    # shellcheck disable=SC1091
    . /etc/os-release; id="${ID:-}"; id_like="${ID_LIKE:-}"
  fi
  local is_wsl="no"
  if [[ -n "${WSL_DISTRO_NAME:-}" ]] || grep -qiE 'microsoft|wsl' /proc/version 2>/dev/null; then
    is_wsl="yes"
  fi
  if [[ "$is_wsl" == "yes" ]] && [[ "$id" =~ (ubuntu|debian) || "$id_like" =~ debian ]]; then
    PLATFORM="wsl-ubuntu"
  elif [[ "$id" == "arch" || "$id_like" =~ arch ]]; then
    PLATFORM="arch"
  elif [[ "$id" == "fedora" || "$id_like" =~ fedora ]]; then
    PLATFORM="asahi"
  else
    die "Unsupported / undetected platform (ID='$id')."
  fi
  log "Platform: ${PLATFORM} ($(uname -m))   FORCE=${FORCE}"
}

pkg_for_platform() {  # args: arch ubuntu fedora macos
  case "$PLATFORM" in
    arch)       echo "$1" ;;
    wsl-ubuntu) echo "$2" ;;
    asahi)      echo "$3" ;;
    macos)      echo "$4" ;;
  esac
}

# --------------------------------------------------------------------------
# Package-manager primitives
# --------------------------------------------------------------------------
pm_install() {
  [[ $# -eq 0 ]] && return 0
  case "$PLATFORM" in
    arch)       sudo pacman -S --needed --noconfirm "$@" ;;
    wsl-ubuntu) sudo apt-get install -y "$@" ;;
    asahi)      sudo dnf install -y "$@" ;;
    macos)      brew install "$@" ;;            # never sudo with Homebrew
  esac
}
pm_refresh() { [[ "$PLATFORM" == "wsl-ubuntu" ]] && sudo apt-get update || true; }

ensure_pkg() {
  local cmd="$1"; shift
  if [[ "$FORCE" != "1" ]] && command -v "$cmd" >/dev/null 2>&1; then
    skip "${cmd} already installed — skipping"; return 0
  fi
  pm_install "$@"
}

aur_helper() {
  local h; for h in yay paru; do command -v "$h" >/dev/null 2>&1 && { echo "$h"; return 0; }; done
  return 1
}

add_to_shell_rc() {
  local marker="$1" block="$2" rc
  for rc in "$HOME/.bashrc" "$HOME/.zshrc"; do
    [[ -e "$rc" ]] || continue
    grep -qF "$marker" "$rc" && continue
    { printf '\n# %s\n' "$marker"; printf '%s\n' "$block"; } >> "$rc"
    log "Updated $rc"
  done
}

# --------------------------------------------------------------------------
# Generic engine for SIMPLE_PKGS
# --------------------------------------------------------------------------
install_simple() {
  local row bin a b c d pkg
  local -a to_install=()
  for row in "${SIMPLE_PKGS[@]}"; do
    [[ "$row" =~ ^[[:space:]]*# ]] && continue
    read -r bin a b c d <<<"$row"
    pkg="$(pkg_for_platform "$a" "$b" "$c" "$d")"
    if [[ -z "$pkg" || "$pkg" == "-" ]]; then
      skip "${bin}: not available on ${PLATFORM} — skipping"; continue
    fi
    if [[ "$FORCE" != "1" ]] && command -v "$bin" >/dev/null 2>&1; then
      skip "${bin} already installed — skipping"; continue
    fi
    to_install+=("$pkg")
  done
  if ((${#to_install[@]})); then
    log "Installing (batched): ${to_install[*]}"
    pm_install "${to_install[@]}"
  else
    skip "all table packages already present"
  fi
}

# --------------------------------------------------------------------------
# Special installers
# --------------------------------------------------------------------------
install_prereqs() {
  case "$PLATFORM" in
    wsl-ubuntu) pm_install curl ca-certificates git wget gnupg ;;
    macos)      : ;;   # brew implies Command Line Tools (git/curl already present)
    *)          pm_install curl ca-certificates git ;;
  esac
}

install_bazelisk() {
  if [[ "$FORCE" != "1" ]] && command -v bazelisk >/dev/null 2>&1; then
    skip "bazelisk already installed — skipping"; return 0
  fi
  case "$PLATFORM" in
    macos)
      log "Installing bazelisk via brew"
      brew install bazelisk
      ;;
    arch)
      local helper; helper="$(aur_helper)" \
        || die "No AUR helper (yay/paru) for bazelisk-bin. Install yay or ask for a makepkg fallback."
      log "Installing bazelisk via ${helper} (AUR: bazelisk-bin)"
      "$helper" -S --needed --noconfirm bazelisk-bin
      ;;
    wsl-ubuntu|asahi)
      log "Installing bazelisk via npm (@bazel/bazelisk) — pulls in Node.js"
      ensure_pkg npm npm
      sudo npm install -g @bazel/bazelisk
      ;;
  esac
}

cuda_nvcc_path() {
  command -v nvcc 2>/dev/null && return 0
  [[ -x /usr/local/cuda/bin/nvcc ]] && { echo /usr/local/cuda/bin/nvcc; return 0; }
  [[ -x /opt/cuda/bin/nvcc ]]       && { echo /opt/cuda/bin/nvcc; return 0; }
  return 1
}

install_cuda() {
  if [[ "$PLATFORM" == "asahi" || "$PLATFORM" == "macos" ]]; then
    skip "CUDA: not applicable on ${PLATFORM} (no NVIDIA GPU) — skipping"; return 0
  fi
  if [[ "$FORCE" != "1" ]] && cuda_nvcc_path >/dev/null; then
    local n; n="$(cuda_nvcc_path)"
    skip "CUDA already installed ($("$n" --version 2>/dev/null | grep -i release || echo "$n")) — skipping"
    return 0
  fi
  case "$PLATFORM" in
    arch)
      log "Installing CUDA via pacman (cuda -> /opt/cuda)"
      pm_install cuda
      add_to_shell_rc "cuda (arch) PATH" \
'export PATH="/opt/cuda/bin:$PATH"
export LD_LIBRARY_PATH="/opt/cuda/lib64:${LD_LIBRARY_PATH:-}"'
      ;;
    wsl-ubuntu)
      log "Installing CUDA for WSL 2 (driverless wsl-ubuntu toolkit)"
      local keyring; keyring="$(mktemp --suffix=.deb)"
      curl -fL --retry 3 -o "$keyring" \
        "https://developer.download.nvidia.com/compute/cuda/repos/wsl-ubuntu/x86_64/cuda-keyring_1.1-1_all.deb"
      sudo dpkg -i "$keyring"; rm -f "$keyring"
      sudo apt-get update
      sudo apt-get install -y cuda-toolkit   # pin with cuda-toolkit-12-8 to avoid roll-forward
      add_to_shell_rc "cuda (wsl) PATH" \
'export PATH="/usr/local/cuda/bin:$PATH"
export LD_LIBRARY_PATH="/usr/local/cuda/lib64:${LD_LIBRARY_PATH:-}"'
      ;;
  esac
}

# --------------------------------------------------------------------------
# Main
# --------------------------------------------------------------------------
main() {
  [[ "$(id -u)" -eq 0 ]] && warn "Running as root; shell rc edits target root's home."
  detect_platform
  pm_refresh
  install_prereqs
  install_simple
  local fn; for fn in "${SPECIAL_INSTALLERS[@]}"; do "$fn"; done
  log "Done."
  echo "Verify: nvim --version | head -n1 ; tmux -V ; fzf --version ; rg --version | head -n1 ; bazelisk version | head -n1"
}
main "$@"
