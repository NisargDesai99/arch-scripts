install_simple() {
  local row bin a b c d pkg
  local -a to_install=()
  for row in "${SIMPLE_PKGS[@]}"; do
    [[ "$row" =~ ^[[:space:]]*# ]] && continue
    read -r bin a b c d <<<"$row"
    pkg="$(pkg_for_platform "$a" "$b" "$c" "$d")"
    if [[ -z "$pkg" || "$pkg" == "-" ]]; then
      skip "${bin}: not available on ${PLATFORM} — skipping"; continue
    fi
    if [[ "$FORCE" != "1" ]] && command -v "$bin" >/dev/null 2>&1; then
      skip "${bin} already installed — skipping"; continue
    fi
    to_install+=("$pkg")
  done
  if ((${#to_install[@]})); then
    log "Installing (batched): ${to_install[*]}"
    pm_install "${to_install[@]}"
  else
    skip "all table packages already present"
  fi
}

